<% layout('./layouts/boilerplate') %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <div class="card col-10 offset-1 listing-card">
        <h2 class="mt-3 mb-3"><%= listing.title %></h2>
        <img src="<%= listing.image.url %>" class="card-img-top show-img mb-3" alt="listing_image">
        <div class="card-body">
          <p class="card-text mb-1"><i>Owned_by : <%= listing.owner.username %></i></p><br>
          <p class="card-text mb-1"><%= listing.description %></p>
          <p class="card-text mb-1"> &#8377; <%= listing.price.toLocaleString() %></p>
          <p class="card-text mb-1"><%= listing.location %></p> 
          <p class="card-text mb-1"><%= listing.country %></p>
        </div>
      </div>
    </div>
    <% if(currentUser && currentUser._id.equals(listing.owner._id)){ %>
      <div class="two-btn ">
        <a href="/listings/<%= listing._id %>/edit">
          <button class="btn btn-primary">Edit</button>
        </a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% } %>
    
    <br>

    <!-- Review Section -->
    <div class="col-8 offset-2">
    <% if(currentUser){ %>
      <hr>
      <h4>Leave A Beautiful Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <fieldset class="starability-slot">
          <legend>Rate Us:</legend>
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
        <div>
          <label for="comment" class="form-label">Comment</label>
          <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
          <div class="invalid-feedback">Please add some comment for Rseview.</div>
        </div>
        <button type="submit" class="btn btn-success mt-3">Submit Review</button>
      </form>
    <% } %>
      <hr>
      <p>All Reviews</p>
      
      <div class="review-container">
        <% for (review of listing.reviews) { %>
          <div class="review-card">
            <div class="review-header">
              <% if (review.author) { %>                                    <!-- Check if review.author exists -->
                <h5 class="review-title"><%= review.author.username %></h5>
              <% } else { %>
                <h5 class="review-title">Anonymous</h5>                     <!-- Fallback if author is not populated -->
              <% } %>
              <br>
              <span class="review-rating"></span>
              <p class="starability-result card-text " data-rating="<%= review.rating %>" ></p>
            </div>
            <p class="review-text"><%= review.comment %></p>
            
            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
              <button type="submit" class="btn btn-dark">Delete</button>
            </form>
          </div>
        <% } %>
      </div>
      
      
      
      
      

      
    </div>











  </div>
</body>
</html>
