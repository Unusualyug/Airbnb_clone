<% layout('./layouts/boilerplate') %>
<div class="row">
  <div class="alert alert-danger col-6 offset-3 text-center" role="alert">
    <h1>🚨 Oops! Something went wrong! 🚨</h1>
    <img
      src="https://cdn-icons-png.flaticon.com/512/564/564619.png"
      alt="Error Icon"
      width="100"
      class="mb-3"
    />

    <h4 class="alert-heading">❌ <%= status %> - <%= message %> ❌</h4>

    <a href="/listings" class="btn btn-primary mt-2">🏠 Go Back Home</a>

    <hr />

    <p>🐞 Bug fixed illustration by on</p>
  </div>
</div>
